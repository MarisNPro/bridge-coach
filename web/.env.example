# Copy to .env.local and fill in from your Supabase project settings.
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Bridge engine base URL. Optional — defaults to the deployed Railway engine.
# Override for local engine dev, e.g. http://127.0.0.1:8000
VITE_ENGINE_URL=https://bridge-coach-production.up.railway.app

# Show the "Continue with Google" sign-in button. Leave unset/false until the
# Google OAuth provider is configured in Supabase (Auth → Providers → Google).
VITE_ENABLE_GOOGLE_AUTH=false
